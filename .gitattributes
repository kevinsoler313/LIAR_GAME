# Archivos de Unity como texto con saltos de línea consistentes
* text=auto
*.cs diff=csharp text
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf

# Binarios
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.JPEG binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary

# Git LFS (hay que tener instalado Git LFS: git lfs install)
# Los .png/.jpg que ya estaban subidos siguen como binarios normales; LFS solo para las carpetas nuevas
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
Assets/Models/Personajes/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/Models/Personajes/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Blender/**/*.png filter=lfs diff=lfs merge=lfs -text
Blender/**/*.jpg filter=lfs diff=lfs merge=lfs -text
